{
  "name": "codex-mobile-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Codex bridge for the internal Codex mobile app.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "smoke:app-server": "powershell -ExecutionPolicy Bypass -File ../scripts/smoke_app_server_bridge.ps1",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.154.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
