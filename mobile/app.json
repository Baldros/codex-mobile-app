{
  "expo": {
    "name": "Codex Mobile",
    "slug": "codex-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "codexmobile",
    "platforms": ["ios", "android", "web"],
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Codex Mobile to attach images from your library to messages."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "internal.codex.mobile"
    },
    "android": {
      "package": "internal.codex.mobile",
      "permissions": ["INTERNET"],
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
